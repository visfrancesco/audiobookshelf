{
    admin off
    auto_https off
    servers {
        trusted_proxies static private_ranges
        trusted_proxies_strict
    }
}
:{$SHELF_HTTP_PORT:80} {
    root * /app/web/public
    encode zstd gzip
    route {
        @legacy path {$ROUTER_BASE_PATH:/audiobookshelf} {$ROUTER_BASE_PATH:/audiobookshelf}/*
        uri @legacy strip_prefix {$ROUTER_BASE_PATH:/audiobookshelf}
        @backend path /api /api/* /public/* /hls/* /socket.io /socket.io/* /status /healthcheck /feed /feed/* /auth/*
        reverse_proxy @backend 127.0.0.1:3333
        @backend_auth {
            method POST
            path /login /logout /init
        }
        reverse_proxy @backend_auth 127.0.0.1:3333
        @legacyFrontend expression `{http.request.orig_uri.path} == "{$ROUTER_BASE_PATH:/audiobookshelf}" || {http.request.orig_uri.path}.startsWith("{$ROUTER_BASE_PATH:/audiobookshelf}/")`
        redir @legacyFrontend {uri} 308
        @assets path /build/*
        header @assets Cache-Control "public, max-age=31536000, immutable"
        @private path /.env /.git/* /composer.* /storage/* /vendor/*
        respond @private 404
        php_fastcgi 127.0.0.1:9000 {
            env HTTP_X_FORWARDED_HOST {host}
        }
        file_server
    }
}
